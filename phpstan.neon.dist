includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - tests/Unit/ConstructorlessInstantiationTest.php
        - tests/Integration/P1MappingRegressionTest.php
        - tests/Unit/MetadataRuntimeServicesTest.php
        - tests/Integration/CriticalHydrationRegressionTest.php
        - tests/Integration/AssociationQueryTest.php
        - tests/Unit/JsonbQueryBuilderTest.php
        - tests/Integration/JsonbQueryApiTest.php
        - tests/Unit/CursorTest.php
        - tests/Unit/CursorPageTest.php
        - tests/Unit/CursorQueryTest.php
        - tests/Integration/CursorPaginationTest.php
        - tests/Unit/FullTextQueryBuilderTest.php
        - tests/Unit/FullTextMappingTest.php
        - tests/Unit/FullTextExpressionTest.php
        - tests/Integration/FullTextIndexTest.php
        - tests/Unit/ConnectionTypeProviderTest.php
        - tests/Integration/ConnectionTypeProviderTest.php
        - tests/Unit/ObjectHydrationTest.php
        - tests/Unit/PartialLoadTrackerTest.php
        - tests/Integration/SchemaRoundTripTest.php
        - tests/Integration/WorkerContextTest.php
        - tests/Integration/FlushBoundaryAuditTest.php
        - tests/Integration/PartialLoadTrackingTest.php
        - tests/Unit/IdentityMapTest.php
        - tests/Integration/IdentityMapTest.php
        - tests/Unit/FlushOperationQueuesTest.php
        - tests/Unit/FieldChangeComparatorTest.php
        - tests/Unit/AssociationChangePlannerTest.php
        - tests/Unit/WriteOrderPlannerTest.php
        - tests/Integration/PostgreSqlWriteTest.php
        - tests/Integration/WriteOrderTest.php
        - tests/Unit/IdentifierScopeTest.php
        - tests/Unit/MappingScopeTest.php
        - tests/Integration/MappingMetadataTest.php
        - benchmarks/hydration.php
        - tests/Integration/TimestampableTest.php
        - tests/Integration/BlameableTest.php
        - tests/Integration/PersistenceAuditTest.php
        - tests/Integration/SoftDeleteTest.php
        - tests/Integration/BulkSoftDeleteTest.php
    tmpDir: .phpstan-cache
    treatPhpDocTypesAsCertain: false
